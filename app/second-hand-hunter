#!/usr/bin/env bash
# Opens second-hand-hunter in its own window. Starts the page server if needed,
# and stops it again when the window is closed (if this script started it).
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
port=8765
url="http://localhost:$port"
window_profile="$HOME/.local/share/second-hand-hunter/window"
started_server=""

up() { curl -s -o /dev/null --max-time 1 "$url/api/status"; }

if ! up; then
  mkdir -p "$repo/data"
  (cd "$repo" && setsid python3 -m hunter serve >> "$repo/data/server.log" 2>&1 &)
  started_server=1
  for _ in $(seq 50); do up && break; sleep 0.2; done
fi

# Its own browser profile, so it opens as a separate app window, not a Chrome tab.
google-chrome --app="$url" --user-data-dir="$window_profile" --class=second-hand-hunter \
  --no-first-run --no-default-browser-check >/dev/null 2>&1 || true

if [ -n "$started_server" ]; then
  pkill -f "^python3 -m hunter serve" || true
fi
